
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #000;
    color: #00ff41;
    font-family: Arial, sans-serif;
    min-height: 100vh;
    overflow: hidden;
}

#matrix {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

.container {
    position: relative;
    z-index: 1;
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 20px;
}

.profile-card {
    width: 100%;
    max-width: 380px;

    background: rgba(0, 10, 2, 0.92);

    border: 1px solid #00ff41;
    border-radius: 15px;

    padding: 30px 25px;

    text-align: center;

    box-shadow:
        0 0 15px rgba(0, 255, 65, 0.3),
        inset 0 0 15px rgba(0, 255, 65, 0.05);
}

.status {
    text-align: right;
    font-size: 12px;
    margin-bottom: 25px;
    color: #00ff41;
}

.profile-image {
    width: 110px;
    height: 110px;

    margin: auto auto 20px;

    border: 2px solid #00ff41;
    border-radius: 50%;

    overflow: hidden;

    box-shadow: 0 0 15px #00ff41;
}

.profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

h1 {
    font-size: 26px;
    letter-spacing: 3px;

    text-shadow: 0 0 10px #00ff41;
}

.profession {
    margin-top: 10px;
    color: #00cc33;
}

.description {
    margin: 25px 0;
    color: #a0c9a5;
    line-height: 1.6;
    font-size: 14px;
}

.skills {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 25px;
}

.skills span {
    border: 1px solid #008f11;
    padding: 7px 10px;
    font-size: 11px;
    border-radius: 5px;
}

.github-button {
    display: block;
    padding: 13px;

    background: #003b16;
    border: 1px solid #00ff41;

    color: #00ff41;
    text-decoration: none;

    transition: 0.3s;
}

.github-button:hover {
    background: #00ff41;
    color: #000;
    box-shadow: 0 0 20px #00ff41;
}

footer {
    margin-top: 25px;
    font-size: 10px;
    color: #478d55;
    letter-spacing: 2px;
}

@media (max-width: 400px) {
    .profile-card {
        padding: 25px 18px;
    }

    h1 {
        font-size: 22px;
    }
}
